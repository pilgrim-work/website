---
import '../styles/global.css';

const { frontmatter = {}, title: propTitle, description: propDescription } = Astro.props;
const title = propTitle ?? frontmatter.title;
const description = propDescription ?? frontmatter.description ?? 'Navigate by Conviction — a philosophy and practical tools for product work.';
const pageTitle = title ? `${title} · Pilgrim Product Work` : 'Pilgrim Product Work';

const nav = [
  { href: '/philosophy/', label: 'Philosophy' },
  { href: '/tools/', label: 'Tools' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">Pilgrim Product Work</a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      {title && path !== '/' && <h1>{title}</h1>}
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Pilgrim Product Work AB</p>
    </footer>
  </body>
</html>
